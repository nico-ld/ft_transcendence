FT_CLIENT_ID=client-id
FT_CLIENT_SECRET=client-secret
# used to sign the session cookies (JWT). At least 32 characters (openssl rand -hex 32)
SESSION_SECRET=
# exactly the address in the browser, port included (the websockets refuse any other origin)
# the 42 app on the intra needs the redirect URI https://localhost:6767/api/auth/42/callback
FRONTEND_URL=https://localhost:6767

# first admin account created at startup if it doesn't exist (optional)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=at-least-8-characters

# DB credentials come from postgres/.env, loaded by docker compose
# for a local run outside Docker you can add them here with POSTGRES_HOST=localhost:
# (or just run docker-compose up -d backend it's simpler tbh as it loads the db with it)
# POSTGRES_USER=user
# POSTGRES_PASSWORD=pass
# POSTGRES_DB=silk_space_db
# POSTGRES_HOST=localhost
