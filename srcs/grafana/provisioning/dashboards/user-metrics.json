{
  "id": null,
  "uid": "user-metrics",
  "title": "User Metrics",
  "tags": ["user", "containers"],
  "timezone": "browser",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{container_label_silk_space_user_id=\"$user_id\"}[1m]) * 100",
          "legendFormat": "User {{user_id}} CPU",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Memory Usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{container_label_silk_space_user_id=\"$user_id\"}",
          "legendFormat": "User {{user_id}} Memory",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "user_id",
        "query": "label_values(container_label_silk_space_user_id)",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" }
}