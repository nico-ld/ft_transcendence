# Docker is rootless so it's socket doesn't live in the default path.
# You need to set the UID of your machine in order for the backend
# to properly access the socket, ex /run/user/102396/docker.sock
# You can use : docker context inspect --format '{{.Endpoints.docker.Host}}'
# to find it
# DOCKER_SOCKET=/run/user/<UID>/docker.sock

# GRAFANA_ADMIN_PASSWORD=
